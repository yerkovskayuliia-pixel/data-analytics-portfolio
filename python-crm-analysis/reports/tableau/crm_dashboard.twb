dimension' type='nominal' /><column-instance column='[Product]' derivation='None' name='[none:Product:nk]' pivot='key' type='nominal' /><column-instance column='[Variant]' derivation='None' name='[none:Variant:nk]' pivot='key' type='nominal' /><column-instance column='[Verdict]' derivation='None' name='[none:Verdict:nk]' pivot='key' type='nominal' /><column-instance column='[MDE pp]' derivation='Avg' name='[avg:MDE pp:qk]' pivot='key' type='quantitative' /><column-instance column='[Expected effect pp]' derivation='Avg' name='[avg:Expected effect pp:qk]' pivot='key' type='quantitative' /></datasource-dependencies><aggregation value='true' /></view><style><style-rule element='mark'><encoding attr='color' field='[federated.crm0ab0variants001].[none:Verdict:nk]' type='palette'><map to='#4e79a7'><bucket>&quot;detectable in 14 days&quot;</bucket></map><map to='#f28e2b'><bucket>&quot;not detectable in 14 days&quot;</bucket></map></encoding></style-rule><style-rule element='gridline'><format attr='line-visibility' scope='cols' value='off' /><format attr='line-visibility' scope='rows' value='off' /></style-rule><style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule><style-rule element='axis'><format attr='tick-color' value='#00000000' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /><encodings><color column='[federated.crm0ab0variants001].[none:Verdict:nk]' /><text column='[federated.crm0ab0variants001].[avg:MDE pp:qk]' /><text column='[federated.crm0ab0variants001].[avg:Expected effect pp:qk]' /></encodings><customized-label><formatted-text><run>MDE </run><run bold='true' fontsize='9' fontcolor='#1f3b57'><![CDATA[<[federated.crm0ab0variants001].[avg:MDE pp:qk]>]]></run><run> pp · expected </run><run fontsize='9' fontcolor='#1f3b57'><![CDATA[<[federated.crm0ab0variants001].[avg:Expected effect pp:qk]>]]></run><run> pp</run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows>([federated.crm0ab0variants001].[none:Product:nk] / [federated.crm0ab0variants001].[none:Variant:nk])</rows><cols>[federated.crm0ab0variants001].[avg:MDE pp:qk]</cols></table><simple-id uuid='{8B433083-3CDE-52DA-8032-7608E3EE06F7}' /></worksheet></worksheets><dashboards><dashboard name='CRM Dashboard'><style><style-rule element='dash-text'><format attr='vertical-align' id='dash-text_13' value='top' /><format attr='vertical-align' id='dash-text_14' value='top' /><format attr='vertical-align' id='dash-text_22' value='top' /><format attr='vertical-align' id='dash-text_23' value='top' /></style-rule></style><size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' sizing-mode='fixed' /><datasources><datasource caption='CRM model' name='federated.crm0model0school01' /></datasources><zones><zone h='100000' id='26' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='6500' id='13' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='24' fontcolor='#4e79a7'>CRM Online School · Leads, Conversion and Revenue</run></formatted-text><zone-style><format attr='margin' value='8' /></zone-style></zone><zone h='93000' id='14' type-v2='text' w='18000' x='0' y='7000'><formatted-text><run bold='true' fontsize='13' fontcolor='#4e79a7'>Key insights</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#1f3b57'>• 4.2% of leads become students; 31% never had a conversation, only 17% reach a consultation.</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#1f3b57'>• Answer within 15 min: 77% reached in 24 h vs 59% later.</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#1f3b57'>• Leads tripled, answers within 15 min fell from 21% to 3%, conversion fell inside every channel.</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#1f3b57'>• Revenue earned counts only months studied: €244k is prepayment, ≈€14k is owed to dropouts.</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontsize='13' fontcolor='#4e79a7'>Data model</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#6b7b8c'>Deals ⟕ Contacts on Contact ID</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#6b7b8c'>Deals ⟕ Calls per contact on Contact ID</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#6b7b8c'>Deals ⟕ Spend on Source + Month</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#6b7b8c'>Ad spend is spread over the leads of each source-month (FIXED LOD).</run><run>Æ&#10;</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#f28e2b'>Tip: click a source in “Conversion by source” to filter the dashboard.</run></formatted-text><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='background-color' value='#e7f1f5' /><format attr='margin' value='8' /></zone-style></zone><zone h='6500' id='3' name='KPI Leads' show-title='false' type-v2='visual' w='16200' x='19000' y='7000'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='4' name='KPI Students' show-title='false' type-v2='visual' w='16200' x='35200' y='7000'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='5' name='KPI C1 lead → student' show-title='false' type-v2='visual' w='16200' x='51400' y='7000'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='6' name='KPI CAC' show-title='false' type-v2='visual' w='16200' x='67600' y='7000'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='7' name='KPI Calls per lead' show-title='false' type-v2='visual' w='16200' x='83800' y='7000'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='8' name='KPI Revenue earned' show-title='false' type-v2='visual' w='16200' x='19000' y='13500'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='9' name='KPI Cash received' show-title='false' type-v2='visual' w='16200' x='35200' y='13500'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='10' name='KPI Prepaid (liability)' show-title='false' type-v2='visual' w='16200' x='51400' y='13500'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='11' name='KPI Refund due' show-title='false' type-v2='visual' w='16200' x='67600' y='13500'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='6500' id='12' name='KPI Talk minutes per lead' show-title='false' type-v2='visual' w='16200' x='83800' y='13500'><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='4' /></zone-style></zone><zone h='26333' id='15' name='Leads by Month' show-title='true' type-v2='visual' w='40500' x='19000' y='21000'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26333' id='16' name='C1 by Month' show-title='true' type-v2='visual' w='40500' x='59500' y='21000'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26333' id='17' name='C1 by Source' show-title='true' type-v2='visual' w='40500' x='19000' y='47333'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26333' id='18' name='CAC by Source' show-title='true' type-v2='visual' w='40500' x='59500' y='47333'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26334' id='19' name='Speed to Lead' show-title='true' type-v2='visual' w='27000' x='19000' y='73666'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26334' id='20' name='Revenue by Product' show-title='true' type-v2='visual' w='27000' x='46000' y='73666'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='26334' id='21' name='Prepaid by Status' show-title='true' type-v2='visual' w='27000' x='73000' y='73666'><zone-style><format attr='margin' value='4' /></zone-style></zone></zone></zones><simple-id uuid='{5F429374-B4DA-5358-8BCA-C29BBF574ACD}' /></dashboard><dashboard name='A/B Test Options'><style><style-rule element='dash-text'><format attr='vertical-align' id='dash-text_13' value='top' /><format attr='vertical-align' id='dash-text_14' value='top' /><format attr='vertical-align' id='dash-text_22' value='top' /><format attr='vertical-align' id='dash-text_23' value='top' /></style-rule></style><size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' sizing-mode='fixed' /><datasources><datasource caption='A/B test options' name='federated.crm0ab0variants001' /></datasources><zones><zone h='100000' id='27' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='6500' id='22' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='22' fontcolor='#4e79a7'>Product Hypotheses and A/B Test Options · 14 days, α = 0.05, power 80%</run></formatted-text><zone-style><format attr='margin' value='8' /></zone-style></zone><zone h='9000' id='23' type-v2='text' w='100000' x='0' y='7000'><formatted-text><run bold='true' fontsize='13' fontcolor='#4e79a7'>Why product A/B tests do not fit into 14 days</run><run>Æ&#10;</run><run fontsize='11' fontcolor='#1f3b57'>Leads with a known product are only 3–4 a day, so even the best 14-day design detects +18–29 pp, far above the expected +4–7.5 pp. Only the speed-to-lead test fits into 14 days, and only if the 15-minute rule runs daily 8:00–23:00 (MDE +9.4 pp vs expected +12.2 pp); in office hours only it would not (MDE +13.6 pp vs +11.0 pp). Product hypotheses are checked as pilots.</run></formatted-text><zone-style><format attr='border-color' value='#75a1c7' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='background-color' value='#e7f1f5' /><format attr='margin' value='8' /></zone-style></zone><zone h='26000' id='24' name='Product Hypotheses' show-title='true' type-v2='visual' w='100000' x='0' y='17000'><zone-style><format attr='margin' value='4' /></zone-style></zone><zone h='56000' id='25' name='A/B Options: MDE in 14 days' show-title='true' type-v2='visual' w='100000' x='0' y='44000'><zone-style><format attr='margin' value='4' /></zone-style></zone></zone></zones><simple-id uuid='{6A1578DC-F6EB-50D0-B2AF-144D88031A75}' /></dashboard></dashboards><windows><window class='worksheet' hidden='true' name='KPI Leads'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge></cards><simple-id uuid='{45311E7E-902A-57BB-95EB-2BD37548FF85}' /></window><window class='worksheet' hidden='true' name='KPI Students'><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card 